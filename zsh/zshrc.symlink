# Resolve dotfiles repo root from this file's symlink target.
export ZSH="${${(%):-%x}:A:h:h}"

# Tying $path to $PATH with -U drops duplicates as entries are prepended.
typeset -U path

# --- SSH ---

# 1Password SSH agent
if [ -S "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ]; then
  export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
fi

# --- Secrets (never committed) ---
if [ -f "$HOME/.secrets" ]; then
  . "$HOME/.secrets"
fi

# --- Build environment ---
export OPENSSL_ROOT_DIR="/opt/homebrew/opt/openssl@3"
export OPENSSL_LIB_DIR="$OPENSSL_ROOT_DIR/lib"
export OPENSSL_INCLUDE_DIR="$OPENSSL_ROOT_DIR/include"
export PKG_CONFIG_PATH="$OPENSSL_ROOT_DIR/lib/pkgconfig"
export CPPFLAGS="-I$OPENSSL_ROOT_DIR/include"
export LDFLAGS="-L$OPENSSL_ROOT_DIR/lib"

# --- Language/tool managers ---

# mise (replaces pyenv, rbenv, nvm)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# direnv
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

export PNPM_HOME="$HOME/Library/pnpm"

# --- PATH additions (listed low to high priority) ---
# ~/.local/bin outranks Homebrew: the agent CLIs installed there (claude, codex)
# are newer than any Homebrew copy of the same name.
for dir in \
  "$HOME/dev/posthog/posthog/tools/infra-scripts/mcp" \
  "$HOME/go/bin" \
  "$PNPM_HOME" \
  "$HOME/.local/bin" \
  "$ZSH/bin"
do
  [ -d "$dir" ] && path=("$dir" $path)
done

# --- Shell utilities ---

listening() {
  if [ $# -eq 0 ]; then
    sudo lsof -iTCP -sTCP:LISTEN -n -P
  elif [ $# -eq 1 ]; then
    sudo lsof -iTCP -sTCP:LISTEN -n -P | grep -i --color "$1"
  else
    echo "Usage: listening [pattern]"
  fi
}

# --- Shell history ---
HISTSIZE=100000
SAVEHIST=100000
HISTFILE="$HOME/.zsh_history"
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS

# --- Aliases and completions ---
autoload -Uz compinit && compinit
source "$ZSH/zsh/aliases.zsh"
source "$ZSH/zsh/claude-completion.zsh"
command -v codex >/dev/null 2>&1 && source <(codex completion zsh)

# --- Shell plugins ---
for plugin in zsh-autosuggestions zsh-syntax-highlighting; do
  [ -r "/opt/homebrew/share/$plugin/$plugin.zsh" ] && source "/opt/homebrew/share/$plugin/$plugin.zsh"
done

# fzf (ctrl-r history, ctrl-t files, alt-c cd)
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)

# zoxide (smart cd: use 'z' instead of 'cd')
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# --- Starship prompt ---
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# opencode
export PATH=/Users/richard/.opencode/bin:$PATH
