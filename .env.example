# Example .env. Copy to .env (gitignored) and fill in. Read by ai/install.sh and
# exported to the shell by zsh/zshrc.symlink.

# Required for the PostHog AI gateway providers (ai/install.sh t3code, opencode,
# and Codex's `[model_providers.posthog]`). A personal API key, created at
# https://us.posthog.com/settings/user-api-keys
POSTHOG_GATEWAY_KEY=

# Optional. Telegram MCP credentials. Create the API ID and hash at
# https://my.telegram.org/apps, then run ai/mcp/telegram-mcp.sh login to create
# the session string. The launcher exposes read-only tools and disables voice
# transcription.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
