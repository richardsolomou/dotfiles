# Example .env. Copy to .env (gitignored) and fill in. Read by the MCP launchers
# in ai/mcp.

# Optional. Telegram MCP credentials. Create the API ID and hash at
# https://my.telegram.org/apps, then run ai/mcp/telegram-mcp.sh login to create
# the session string. The launcher exposes read-only tools and disables voice
# transcription.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# Required for the Slack MCP. Create a Slack user token with the scopes needed
# by slack-mcp-server, then keep it only in this gitignored file.
SLACK_MCP_XOXP_TOKEN=

# Optional. Slack Later access requires both browser session credentials.
# When both are set, the launcher uses them instead of the OAuth token.
SLACK_MCP_XOXC_TOKEN=
SLACK_MCP_XOXD_TOKEN=
