# Example .env. Copy to .env (gitignored) and fill in. Read by the skill sync
# scripts, by ai/install.sh, and exported to the shell by zsh/zshrc.symlink.

# Required. PostHog personal API key with llm_skill:read and llm_skill:write scopes.
# Create at https://us.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=

# Optional. Defaults to 2 (the PostHog App + Website project where richard-* skills live).
# POSTHOG_PROJECT_ID=2

# Optional. Defaults to https://us.posthog.com. Override for EU cloud or self-hosted.
# POSTHOG_HOST=https://us.posthog.com

# Required for the PostHog AI gateway providers (ai/install.sh t3code, opencode,
# and Codex's `[model_providers.posthog]`). A personal API key, created at
# https://us.posthog.com/settings/user-api-keys
POSTHOG_GATEWAY_KEY=
