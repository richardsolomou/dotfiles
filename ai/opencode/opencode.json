{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "posthog": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "PostHog AI Gateway",
      "options": {
        "baseURL": "https://ai-gateway.us.posthog.com/v1",
        "apiKey": "{env:POSTHOG_GATEWAY_KEY}"
      },
      "models": {
        "moonshotai/kimi-k3": { "name": "Kimi K3" },
        "zai-org/glm-5.2": { "name": "GLM-5.2" },
        "zai-org/glm-5.3": { "name": "GLM-5.3" },
        "zai-org/glm-5.3-flash": { "name": "GLM-5.3-Flash" }
      }
    }
  }
}
