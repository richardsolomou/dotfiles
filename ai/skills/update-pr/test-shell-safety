#!/bin/sh
# Generated PR titles, bodies, and review replies must reach gh as file input,
# never substituted into a shell command. Every skill that posts such text is
# held to the same rule.
set -eu

skills=$(dirname "$0")/..

grep -F -- '--input /tmp/update-pr.json' "$skills/update-pr/SKILL.md" >/dev/null
grep -F -- 'Never substitute generated title or Markdown directly into a shell command' "$skills/update-pr/SKILL.md" >/dev/null

status=0
for skill in "$skills"/*/SKILL.md; do
  if grep -nE -- '--body "|--title "<|-f body=' "$skill" | grep -vE -- '--body "comment"' >/dev/null; then
    echo "$(basename "$(dirname "$skill")") interpolates generated PR content into a shell command"
    grep -nE -- '--body "|--title "<|-f body=' "$skill" | grep -vE -- '--body "comment"'
    status=1
  fi
done
exit $status
