#!/usr/bin/env python3

import json
import os
import shlex
import subprocess
import sys
from pathlib import Path


def main():
    name = Path(sys.argv[0]).name
    if name in ("cliproxy-claude", "cliproxy-codex"):
        client = name.removeprefix("cliproxy-")
        args = sys.argv[1:]
    elif len(sys.argv) > 1 and sys.argv[1] in ("claude", "codex"):
        client, *args = sys.argv[1:]
    else:
        print("Usage: cliproxy {claude|codex} [arguments…]", file=sys.stderr)
        return 1

    env = os.environ.copy()
    env_file = Path(__file__).resolve().parent.parent / ".env"
    if env_file.is_file():
        for line in env_file.read_text().splitlines():
            key, separator, value = line.partition("=")
            if (
                separator
                and key
                in (
                    "CLIPROXY_API_KEY",
                    "CF_ACCESS_CLIENT_ID",
                    "CF_ACCESS_CLIENT_SECRET",
                )
                and not env.get(key)
            ):
                values = shlex.split(value, comments=True)
                if values:
                    env[key] = values[0]

    key = os.environ.get("CLIPROXY_API_KEY")
    if not key and client == "claude":
        key = os.environ.get("ANTHROPIC_AUTH_TOKEN")
    key = key or env.get("CLIPROXY_API_KEY")
    if not key:
        print(
            "Set CLIPROXY_API_KEY in the environment or dotfiles .env.", file=sys.stderr
        )
        return 1

    lan = env.get("CLIPROXY_LAN_URL", "http://homelab.local:8317").rstrip("/")
    try:
        probe = subprocess.run(
            [
                "curl",
                "-q",
                "--noproxy",
                "*",
                "--silent",
                "--output",
                os.devnull,
                "--write-out",
                "%{http_code}",
                "--connect-timeout",
                "1",
                "--max-time",
                "2",
                lan + "/v1/models",
            ],
            capture_output=True,
            text=True,
            timeout=3,
            check=False,
        )
        local = probe.returncode == 0 and probe.stdout == "401"
    except (OSError, subprocess.TimeoutExpired):
        local = False
    endpoint = lan if local else "https://ai.ras.sh"

    if local:
        for variable in (
            "CF_ACCESS_CLIENT_ID",
            "CF_ACCESS_CLIENT_SECRET",
            "ANTHROPIC_CUSTOM_HEADERS",
        ):
            env.pop(variable, None)

    if client == "claude":
        env.update(
            ANTHROPIC_BASE_URL=endpoint, ANTHROPIC_AUTH_TOKEN=key, ANTHROPIC_API_KEY=""
        )
        if not local and not env.get("ANTHROPIC_CUSTOM_HEADERS"):
            env["ANTHROPIC_CUSTOM_HEADERS"] = (
                "CF-Access-Client-Id: "
                + env.get("CF_ACCESS_CLIENT_ID", "")
                + "\nCF-Access-Client-Secret: "
                + env.get("CF_ACCESS_CLIENT_SECRET", "")
            )
    else:
        env["CLIPROXY_API_KEY"] = key
        overrides = [
            "-c",
            "model_provider=cliproxy",
            "-c",
            "model_providers.cliproxy.base_url=" + json.dumps(endpoint + "/v1"),
        ]
        args = overrides + args

    os.execvpe(client, [client, *args], env)


if __name__ == "__main__":
    sys.exit(main())
