#!/usr/bin/env bash
# Walk every git repo up to one subfolder under ~/dev (e.g. ~/dev/posthog/posthog.com);
# if it has no pending changes, switch to main/master and pull. Depth is capped to
# avoid vendored/build .git dirs nested inside repos (e.g. .terraform modules, gatsby caches).
# Repos are independent, so updates run in parallel batches. Each repo prints one
# result line as it finishes, plus a running counter pinned to the last line.

PARALLEL=8

if [ -t 1 ]; then
    GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; DIM=$'\033[2m'; RESET=$'\033[0m'
else
    GREEN=; YELLOW=; RED=; DIM=; RESET=
fi

mapfile -t repos < <(find ~/dev -maxdepth 3 -type d -name .git | sed 's:/\.git$::' | sort)
n=${#repos[@]}
if [ "$n" -eq 0 ]; then
    echo "No repos found under ~/dev"
    exit 0
fi

resultsdir=$(mktemp -d)
trap 'rm -rf "$resultsdir"' EXIT

sync_repo() {
    local idx="$1" repo="$2" name
    name="${repo#"$HOME"/dev/}"

    cd "$repo" 2>/dev/null || { printf '%s❌ %s: cd failed%s\n' "$RED" "$name" "$RESET" > "$resultsdir/$idx"; return; }

    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
        printf '%s⏭️  %s: skipped (uncommitted changes)%s\n' "$YELLOW" "$name" "$RESET" > "$resultsdir/$idx"
        return
    fi

    local branch
    branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
    if [ -z "$branch" ]; then
        if git show-ref --verify --quiet refs/heads/main 2>/dev/null; then
            branch=main
        else
            branch=master
        fi
    fi

    if git checkout -q "$branch" 2>/dev/null && git pull -q 2>/dev/null; then
        printf '%s✅ %s: updated (%s)%s\n' "$GREEN" "$name" "$branch" "$RESET" > "$resultsdir/$idx"
    else
        printf '%s❌ %s: failed (%s)%s\n' "$RED" "$name" "$branch" "$RESET" > "$resultsdir/$idx"
    fi
}

done_count=0
progress() {
    if [ -t 1 ]; then
        printf '\r\033[2K%s⏳ %d/%d repos synced%s' "$DIM" "$done_count" "$n" "$RESET"
    else
        printf '%d/%d repos synced\n' "$done_count" "$n"
    fi
}

progress
batch_start=0
while [ "$batch_start" -lt "$n" ]; do
    batch_end=$((batch_start + PARALLEL))
    if [ "$batch_end" -gt "$n" ]; then
        batch_end=$n
    fi

    for ((i = batch_start; i < batch_end; i++)); do
        sync_repo "$i" "${repos[$i]}" &
    done
    wait

    for ((i = batch_start; i < batch_end; i++)); do
        if [ -t 1 ]; then
            printf '\r\033[2K%s\n' "$(cat "$resultsdir/$i")"
        else
            cat "$resultsdir/$i"
        fi
        done_count=$((done_count + 1))
        progress
    done

    batch_start=$batch_end
done
printf '\n'
