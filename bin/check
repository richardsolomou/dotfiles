#!/usr/bin/env bash
#
# Validate the repo: shell syntax, JSON, markdown, and skill cross-references.
# Run before pushing; CI runs the same script.
#
# Each check skips with a warning when its tool is missing, so this stays
# usable on a machine that has not installed everything yet. Only real
# failures set the exit code.

set -uo pipefail

ZSH="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd -P)"
. "$ZSH/ai/helpers/output.sh"

cd "$ZSH" || die "cannot enter $ZSH"
FAILED=0

info "Checking shell scripts…"
mapfile -t SHELL_FILES < <(
    git ls-files 'bin/*' 'script/*' '*.sh' '*.zsh' \
        | while read -r f; do
            [ -f "$f" ] || continue
            case "$f" in
                *.sh | *.zsh) echo "$f" ;;
                *) head -1 "$f" | grep -q '^#!.*\(sh\|bash\|zsh\)' && echo "$f" ;;
            esac
          done
)

POSIX_FILES=()
for f in "${SHELL_FILES[@]}"; do
    # zsh-only syntax (`$words[1]`, `local -a`) is not valid sh or bash, so zsh
    # judges its own files and shellcheck never sees them.
    case "$f" in
        *.zsh | *zshrc* | *zshenv* | *zprofile*)
            if command -v zsh > /dev/null 2>&1; then
                zsh -n "$f" || { error "zsh syntax: $f"; FAILED=1; }
            fi
            ;;
        *)
            bash -n "$f" || { error "bash syntax: $f"; FAILED=1; }
            POSIX_FILES+=("$f")
            ;;
    esac
done
success "Shell syntax OK (${#SHELL_FILES[@]} files)"

if [ ${#POSIX_FILES[@]} -eq 0 ]; then
    :
elif command -v shellcheck > /dev/null 2>&1; then
    # SC1091: sourced helpers are resolved at runtime, not by shellcheck.
    shellcheck -e SC1091 -S warning "${POSIX_FILES[@]}" \
        && success "shellcheck clean (${#POSIX_FILES[@]} files)" \
        || { error "shellcheck reported problems"; FAILED=1; }
else
    warning "shellcheck not installed - skipping"
fi

info "Checking JSON…"
if command -v jq > /dev/null 2>&1; then
    JSON_COUNT=0
    while read -r f; do
        [ -f "$f" ] || continue
        jq empty "$f" 2> /dev/null || { error "invalid JSON: $f"; FAILED=1; }
        JSON_COUNT=$((JSON_COUNT + 1))
    done < <(git ls-files '*.json')
    success "JSON parses ($JSON_COUNT files)"
else
    warning "jq not installed - skipping"
fi

info "Checking markdown…"
if command -v markdownlint > /dev/null 2>&1; then
    MARKDOWNLINT=(markdownlint)
elif command -v npx > /dev/null 2>&1; then
    MARKDOWNLINT=(npx --yes markdownlint-cli)
else
    MARKDOWNLINT=()
fi
if [ ${#MARKDOWNLINT[@]} -gt 0 ]; then
    mapfile -t MD_FILES < <(git ls-files '*.md')
    "${MARKDOWNLINT[@]}" "${MD_FILES[@]}" \
        && success "markdownlint clean (${#MD_FILES[@]} files)" \
        || { error "markdownlint reported problems"; FAILED=1; }
else
    warning "markdownlint not available - skipping"
fi

info "Checking skill names…"
while read -r skill; do
    dir="$(basename "$(dirname "$skill")")"
    name="$(sed -n '2,/^---$/{s/^name: *//p;}' "$skill" | head -1)"
    [ "$name" = "$dir" ] || { error "skill name '$name' does not match directory $dir"; FAILED=1; }
done < <(git ls-files 'ai/skills/*/SKILL.md')
success "Skill names match their directories"

# A skill naming a sibling that no longer exists is silent breakage: the model
# is told to load something that was deleted or renamed. Two shapes count as a
# reference: a backticked name of an existing skill's shape (`rs-*`), and any
# backticked name followed by the word "skill". Paths such as
# `/tmp/rs-update-pr-title.txt` and prose mentions do not register.
info "Checking skill cross-references…"
DANGLING=0
while read -r skill; do
    name="$(basename "$(dirname "$skill")")"
    {
        grep -ohE '`rs-[a-z0-9-]{2,40}`' "$skill"
        grep -ohE '`[a-z0-9][a-z0-9-]{2,40}` skill' "$skill" | sed 's/ skill$//'
    } | tr -d '`' \
        | sort -u \
        | while read -r ref; do
            [ "$ref" = "$name" ] && continue
            [ -d "ai/skills/$ref" ] && continue
            echo "$name -> $ref"
          done
done < <(git ls-files 'ai/skills/*/SKILL.md') > /tmp/dotfiles-dangling-refs.$$ 2> /dev/null

if [ -s /tmp/dotfiles-dangling-refs.$$ ]; then
    while read -r line; do
        error "skill reference does not exist: $line"
        DANGLING=1
    done < /tmp/dotfiles-dangling-refs.$$
    FAILED=1
fi
rm -f /tmp/dotfiles-dangling-refs.$$
[ "$DANGLING" -eq 0 ] && success "Skill cross-references resolve"

# Skills ship their own tests next to the scripts they cover.
info "Running skill tests…"
TEST_COUNT=0
while read -r t; do
    case "$t" in
        *.py)
            # Plain assert-based tests; run them without a pytest dependency.
            python3 - "$t" > /tmp/dotfiles-skill-test.$$ 2>&1 <<'PY' \
                || { error "failed: $t"; cat /tmp/dotfiles-skill-test.$$; FAILED=1; }
import importlib.util, sys
spec = importlib.util.spec_from_file_location("t", sys.argv[1])
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
for name in sorted(n for n in dir(mod) if n.startswith("test_")):
    getattr(mod, name)()
PY
            ;;
        *)
            bash "$t" > /tmp/dotfiles-skill-test.$$ 2>&1 \
                || { error "failed: $t"; cat /tmp/dotfiles-skill-test.$$; FAILED=1; }
            ;;
    esac
    TEST_COUNT=$((TEST_COUNT + 1))
done < <(git ls-files 'ai/skills/*/test-*' 'ai/skills/*/scripts/test-*')
rm -f /tmp/dotfiles-skill-test.$$
success "Skill tests ran ($TEST_COUNT files)"

echo ""
if [ "$FAILED" -eq 0 ]; then
    success "All checks passed"
else
    error "Checks failed"
fi
exit "$FAILED"
