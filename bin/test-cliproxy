#!/usr/bin/env python3

import json
import os
import shutil
import subprocess
import tempfile
import threading
import time
import unittest
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


class CliproxyTest(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.bin = self.root / "bin"
        self.bin.mkdir()
        launcher = ROOT / "bin/cliproxy"
        if launcher.exists():
            shutil.copy2(launcher, self.bin / "cliproxy")
        self.env = {
            **os.environ,
            "PATH": str(self.bin) + os.pathsep + os.environ["PATH"],
            "CLIPROXY_API_KEY": "test-key",
            "CF_ACCESS_CLIENT_ID": "test-id",
            "CF_ACCESS_CLIENT_SECRET": "test-secret",
        }
        for key in (
            "ANTHROPIC_BASE_URL",
            "ANTHROPIC_AUTH_TOKEN",
            "ANTHROPIC_CUSTOM_HEADERS",
            "CLIPROXY_LAN_URL",
        ):
            self.env.pop(key, None)
        self.write_executable(
            "curl",
            '#!/bin/sh\nprintf %s "${TEST_LAN_STATUS:-401}"\nexit "${TEST_CURL_EXIT:-0}"\n',
        )
        capture = """#!/usr/bin/env python3
import json,os,sys
print(json.dumps({'args':sys.argv[1:],'env':{k:v for k,v in os.environ.items() if k.startswith(('ANTHROPIC_', 'CF_ACCESS_', 'CLIPROXY_'))},'stdin':sys.stdin.read()}))
sys.exit(int(os.environ.get('TEST_CLIENT_EXIT','0')))
"""
        self.write_executable("claude", capture)
        self.write_executable("codex", capture)

    def write_executable(self, name, text):
        path = self.bin / name
        path.write_text(text)
        path.chmod(0o755)

    def launch(self, client, *args, alias=False):
        launcher = self.bin / "cliproxy"
        if alias:
            executable = self.bin / ("cliproxy-" + client)
            executable.symlink_to(launcher)
            command = [str(executable), *args]
        else:
            command = ["python3", str(launcher), client, *args]
        return subprocess.run(
            command,
            env=self.env,
            input="request input\n",
            text=True,
            capture_output=True,
            check=False,
        )

    def test_claude_prefers_lan_and_drops_access_headers(self):
        self.env["ANTHROPIC_CUSTOM_HEADERS"] = "CF-Access-Client-Secret: stale-secret"
        result = json.loads(self.launch("claude").stdout)
        self.assertEqual(
            (
                result["env"]["ANTHROPIC_BASE_URL"],
                result["env"]["ANTHROPIC_AUTH_TOKEN"],
                result["env"].get("ANTHROPIC_CUSTOM_HEADERS"),
                result["env"].get("CF_ACCESS_CLIENT_SECRET"),
            ),
            ("http://homelab.local:8317", "test-key", None, None),
        )

    def test_codex_prefers_lan_without_cloudflare_credentials(self):
        result = json.loads(self.launch("codex", "app-server", alias=True).stdout)
        self.assertEqual(
            (result["args"], result["env"].get("CF_ACCESS_CLIENT_SECRET")),
            (
                [
                    "-c",
                    "model_provider=cliproxy",
                    "-c",
                    'model_providers.cliproxy.base_url="http://homelab.local:8317/v1"',
                    "app-server",
                ],
                None,
            ),
        )

    def test_unreachable_lan_uses_cloudflare(self):
        self.env["TEST_CURL_EXIT"] = "7"
        result = json.loads(self.launch("claude", alias=True).stdout)
        self.assertEqual(
            (
                result["env"]["ANTHROPIC_BASE_URL"],
                result["env"]["ANTHROPIC_CUSTOM_HEADERS"],
            ),
            (
                "https://ai.ras.sh",
                "CF-Access-Client-Id: test-id\nCF-Access-Client-Secret: test-secret",
            ),
        )

    def test_wrong_http_response_uses_cloudflare(self):
        self.env["TEST_LAN_STATUS"] = "500"
        result = json.loads(self.launch("codex").stdout)
        self.assertEqual(
            (
                result["args"][3],
                result["env"]["CF_ACCESS_CLIENT_ID"],
                result["env"]["CF_ACCESS_CLIENT_SECRET"],
            ),
            (
                'model_providers.cliproxy.base_url="https://ai.ras.sh/v1"',
                "test-id",
                "test-secret",
            ),
        )

    def test_arguments_stdin_and_exit_status_survive(self):
        self.env["TEST_CLIENT_EXIT"] = "23"
        result = self.launch(
            "claude", "--resume", "value with spaces", "--setting", "$(literal)"
        )
        self.assertEqual(
            (
                json.loads(result.stdout)["args"],
                json.loads(result.stdout)["stdin"],
                result.returncode,
            ),
            (
                ["--resume", "value with spaces", "--setting", "$(literal)"],
                "request input\n",
                23,
            ),
        )

    def test_dotenv_is_read_relative_to_symlink_target(self):
        self.env.pop("CLIPROXY_API_KEY")
        (self.root / ".env").write_text('CLIPROXY_API_KEY="file-key"\r\n')
        result = json.loads(self.launch("claude", alias=True).stdout)
        self.assertEqual(result["env"]["ANTHROPIC_AUTH_TOKEN"], "file-key")

    def test_codex_does_not_use_an_unrelated_anthropic_token(self):
        self.env.pop("CLIPROXY_API_KEY")
        self.env["ANTHROPIC_AUTH_TOKEN"] = "unrelated-token"
        (self.root / ".env").write_text("CLIPROXY_API_KEY=file-key\n")
        result = json.loads(self.launch("codex").stdout)
        self.assertEqual(result["env"]["CLIPROXY_API_KEY"], "file-key")

    def test_t3_claude_works_with_only_stored_secrets(self):
        for key in (
            "CLIPROXY_API_KEY",
            "CF_ACCESS_CLIENT_ID",
            "CF_ACCESS_CLIENT_SECRET",
        ):
            self.env.pop(key)
        self.env.update(
            {
                "ANTHROPIC_AUTH_TOKEN": "stored-key",
                "ANTHROPIC_CUSTOM_HEADERS": "stored-access-headers",
                "TEST_CURL_EXIT": "7",
            }
        )
        result = json.loads(self.launch("claude").stdout)
        self.assertEqual(
            (
                result["env"]["ANTHROPIC_AUTH_TOKEN"],
                result["env"]["ANTHROPIC_CUSTOM_HEADERS"],
            ),
            ("stored-key", "stored-access-headers"),
        )

    def test_real_http_probe_selects_lan_without_sending_credentials(self):
        requests = []

        class Handler(BaseHTTPRequestHandler):
            def do_GET(self):
                requests.append((self.path, self.headers.get("Authorization")))
                self.send_response(401)
                self.end_headers()

            def log_message(self, *args):
                pass

        server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        thread = threading.Thread(target=server.serve_forever)
        thread.start()
        try:
            (self.bin / "curl").unlink()
            (self.bin / "curl").symlink_to(shutil.which("curl"))
            endpoint = "http://127.0.0.1:" + str(server.server_port)
            self.env["CLIPROXY_LAN_URL"] = endpoint
            result = json.loads(self.launch("claude").stdout)
        finally:
            server.shutdown()
            server.server_close()
            thread.join()
        self.assertEqual(
            (result["env"]["ANTHROPIC_BASE_URL"], requests),
            (endpoint, [("/v1/models", None)]),
        )

    def test_slow_lan_probe_falls_back_within_four_seconds(self):
        self.write_executable("curl", "#!/bin/sh\nexec /bin/sleep 10\n")
        started = time.monotonic()
        result = json.loads(self.launch("claude").stdout)
        self.assertEqual(
            (result["env"]["ANTHROPIC_BASE_URL"], time.monotonic() - started < 4),
            ("https://ai.ras.sh", True),
        )

    def test_zsh_wrapper_uses_shared_launcher(self):
        source = (ROOT / "zsh/zshrc.symlink").read_text()
        start = source.index('if [ -n "${CLIPROXY_API_KEY:-}" ]')
        block = source[start : source.index("\nfi", start) + 3]
        env = {**self.env, "ZSH": str(ROOT), "TEST_PATH": self.env["PATH"]}
        result = subprocess.run(
            [
                "zsh",
                "-f",
                "-c",
                'PATH="$TEST_PATH"\n' + block + '\nclaude "argument with spaces"',
            ],
            env=env,
            input="wrapper input",
            text=True,
            capture_output=True,
            check=True,
        )
        payload = json.loads(result.stdout)
        self.assertEqual(
            (payload["args"], payload["stdin"], payload["env"]["ANTHROPIC_BASE_URL"]),
            (["argument with spaces"], "wrapper input", "http://homelab.local:8317"),
        )

    @unittest.skipUnless(shutil.which("fish"), "fish is not installed")
    def test_fish_wrapper_uses_shared_launcher(self):
        env = {**self.env, "TEST_PATH": self.env["PATH"]}
        command = (
            "set -gx PATH (string split : -- $TEST_PATH); source "
            + str(ROOT / "fish/cliproxy.fish")
            + '; claude "argument with spaces"'
        )
        result = subprocess.run(
            ["fish", "--no-config", "-c", command],
            env=env,
            input="wrapper input",
            text=True,
            capture_output=True,
            check=True,
        )
        payload = json.loads(result.stdout)
        self.assertEqual(
            (payload["args"], payload["stdin"], payload["env"]["ANTHROPIC_BASE_URL"]),
            (["argument with spaces"], "wrapper input", "http://homelab.local:8317"),
        )

    def test_installer_updates_existing_proxy_instances_and_preserves_other_settings(
        self,
    ):
        current = self.root / "settings.json"
        current.write_text(
            json.dumps(
                {
                    "providerInstances": {
                        "codex": {
                            "driver": "codex",
                            "config": {
                                "launchArgs": "-c model_provider=cliproxy",
                                "homePath": "/existing-home",
                            },
                        },
                        "custom": {
                            "driver": "codex",
                            "config": {
                                "binaryPath": "/custom/codex",
                                "launchArgs": "-c model_provider=cliproxy",
                            },
                        },
                        "unrelated": {
                            "driver": "codex",
                            "config": {
                                "launchArgs": "-c model_provider=cliproxy_other"
                            },
                        },
                        "cpa_old": {"driver": "codex"},
                    }
                }
            )
        )
        source = (ROOT / "ai/install.sh").read_text()
        start = source.index("    T3_CONFIG=$(jq -n")
        block = source[start : source.index("\n\n    set_json_settings", start)]
        env = {
            **self.env,
            "T3_SETTINGS": str(current),
            "T3_INSTANCE_FILE": str(ROOT / "ai/t3code/provider-instances.json"),
            "OWNED_PREFIXES": "^(phaig|cpa)_",
        }
        result = subprocess.run(
            ["bash", "-c", block + '\nprintf %s "$T3_CONFIG"'],
            env=env,
            text=True,
            capture_output=True,
            check=True,
        )
        instances = json.loads(result.stdout)["providerInstances"]
        self.assertEqual(
            (
                instances["codex"]["config"],
                instances["custom"]["config"]["binaryPath"],
                instances["unrelated"]["config"].get("binaryPath"),
                "cpa_old" in instances,
                instances["cpa_claude"]["config"]["binaryPath"],
                instances["cpa_codex"]["config"]["binaryPath"],
            ),
            (
                {
                    "launchArgs": "-c model_provider=cliproxy",
                    "homePath": "/existing-home",
                    "binaryPath": "cliproxy-codex",
                },
                "/custom/codex",
                None,
                False,
                "cliproxy-claude",
                "cliproxy-codex",
            ),
        )

    def test_missing_proxy_key_fails_before_client_launch(self):
        self.env.pop("CLIPROXY_API_KEY")
        result = self.launch("claude")
        self.assertEqual(
            (result.returncode, result.stdout, "CLIPROXY_API_KEY" in result.stderr),
            (1, "", True),
        )


if __name__ == "__main__":
    unittest.main()
